rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ids/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'];
    }
  }
}